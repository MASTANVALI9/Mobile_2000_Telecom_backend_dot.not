		{
			"name": "4. Timeout Simulation & Reconciliation",
			"item": [
				{
					"name": "Trigger Provider Timeout (₹299 Airtel)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Status is PENDING due to provider timeout\", function () {",
									"    pm.expect(jsonData.status).to.eql(\"PENDING\");",
									"    pm.expect(jsonData.errorMessage).to.include(\"timed out\");",
									"});",
									"if (jsonData.transactionId) {",
									"    pm.collectionVariables.set(\"pendingTxnId\", jsonData.transactionId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{apiKey_main}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobileNumber\": \"9876543210\",\n  \"operatorName\": \"Airtel\",\n  \"amount\": 299.00\n}"
						},
						"url": {
							"raw": "{{baseUrl_main}}/api/recharge",
							"host": [
								"{{baseUrl_main}}"
							],
							"path": [
								"api",
								"recharge"
							]
						},
						"description": "Mock provider simulates a 12s delay for ₹299 Airtel, exceeding Main API's 8s HttpClient timeout. Status is set to PENDING."
					},
					"response": []
				},
				{
					"name": "Check Status After Reconciliation (Wait 30s)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
