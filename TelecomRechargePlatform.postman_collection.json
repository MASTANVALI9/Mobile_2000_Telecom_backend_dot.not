									"var jsonData = pm.response.json();",
									"pm.test(\"Pending transaction resolved to SUCCESS\", function () {",
									"    pm.expect(jsonData.status).to.eql(\"SUCCESS\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{apiKey_main}}"
							}
						],
						"url": {
							"raw": "{{baseUrl_main}}/api/recharge/status/{{pendingTxnId}}",
							"host": [
								"{{baseUrl_main}}"
							],
							"path": [
								"api",
								"recharge",
								"status",
								"{{pendingTxnId}}"
							]
						},
						"description": "After 30s background worker reconciles the transaction with provider."
					},
					"response": []
				}
			]
