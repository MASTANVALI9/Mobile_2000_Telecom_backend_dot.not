		{
			"name": "2. Idempotency & Duplicate Protection",
			"item": [
				{
					"name": "Step 1: First Request with Specific TxnId",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var customId = 'TXN-DEMO-' + Date.now();",
									"pm.collectionVariables.set('demoTxnId', customId);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"First request processed by Provider\", function () {",
									"    pm.expect(jsonData.status).to.eql(\"SUCCESS\");",
									"    pm.expect(jsonData.transactionId).to.eql(pm.collectionVariables.get('demoTxnId'));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{apiKey_main}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"transactionId\": \"{{demoTxnId}}\",\n  \"mobileNumber\": \"9876500001\",\n  \"operatorName\": \"Jio\",\n  \"amount\": 199.00\n}"
						},
						"url": {
							"raw": "{{baseUrl_main}}/api/recharge",
							"host": [
								"{{baseUrl_main}}"
							],
							"path": [
								"api",
								"recharge"
							]
						},
						"description": "First request sent to provider and saved in database."
					},
					"response": []
				},
				{
					"name": "Step 2: Second Request (Idempotent - Provider NOT called)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Returns idempotent message and does NOT generate second recharge\", function () {",
									"    pm.expect(jsonData.status).to.eql(\"SUCCESS\");",
									"    pm.expect(jsonData.transactionId).to.eql(pm.collectionVariables.get('demoTxnId'));",
									"    pm.expect(jsonData.message).to.include(\"Already recharged\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{apiKey_main}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"transactionId\": \"{{demoTxnId}}\",\n  \"mobileNumber\": \"9876500001\",\n  \"operatorName\": \"Jio\",\n  \"amount\": 199.00\n}"
						},
						"url": {
							"raw": "{{baseUrl_main}}/api/recharge",
							"host": [
								"{{baseUrl_main}}"
							],
							"path": [
								"api",
								"recharge"
							]
						},
						"description": "Second request with same TransactionId returns cached status immediately without calling provider."
					},
					"response": []
				},
				{
					"name": "Step 3: Rapid Duplicate (Same Mobile/Amount within 10 mins)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Duplicate guard catches rapid retry without transaction ID\", function () {",
									"    pm.expect(jsonData.status).to.be.oneOf([\"SUCCESS\", \"PENDING\"]);",
									"    pm.expect(jsonData.message).to.include(\"Already recharged\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{apiKey_main}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobileNumber\": \"9876500001\",\n  \"operatorName\": \"Jio\",\n  \"amount\": 199.00\n}"
						},
						"url": {
							"raw": "{{baseUrl_main}}/api/recharge",
							"host": [
								"{{baseUrl_main}}"
							],
							"path": [
								"api",
								"recharge"
							]
						},
						"description": "Duplicate guard catches repeated recharge for same mobile+operator+amount within 10 min window."
					},
					"response": []
				}
			]
